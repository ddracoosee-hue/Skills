#!/bin/sh
# Blocks commits that add secrets, private text markers or personal absolute paths to skills/ or
# templates/, and runs the structure check on changed skills. Enabled by install.ps1 / install.sh
# (git config core.hooksPath .githooks). Git for Windows runs this with its bundled sh.
for py in python3 python py; do
  if command -v "$py" >/dev/null 2>&1; then PY="$py"; break; fi
done
[ -n "$PY" ] || { echo "pre-commit: no python found; install Python 3.10+ to enable the scan" >&2; exit 1; }

files=$(git diff --cached --name-only --diff-filter=ACM -- skills templates)
[ -z "$files" ] && exit 0
# shellcheck disable=SC2086
"$PY" tools/check_skills.py --scan $files || { echo "pre-commit: remove the flagged content (see above)" >&2; exit 1; }

skills=$(printf '%s\n' $files | sed -n 's#^skills/\([^/]*\)/.*#skills/\1#p' | sort -u)
[ -z "$skills" ] && exit 0
# shellcheck disable=SC2086
"$PY" tools/check_skills.py $skills
