#!/bin/sh
# Pre-commit gate: scans the staged skills/templates content for secrets, validates
# changed skills, and checks the generated map — all against the Git index (what is
# being committed), never the worktree. Git for Windows runs this with its bundled
# sh; node (20+) must be on PATH. The gate itself lives in
# tools/check-skills.mjs --staged, which uses NUL-delimited git output so that
# spaces, Unicode, and quoting in filenames cannot corrupt the file list.
command -v node >/dev/null 2>&1 || { echo "pre-commit: node not found; install Node 20+ to enable the scan" >&2; exit 1; }
root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "pre-commit: cannot find the repo root" >&2; exit 1; }
exec node "$root/tools/check-skills.mjs" --staged
